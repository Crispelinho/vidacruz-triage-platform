{
  "uid": "vidacruz-nfr07",
  "title": "VidaCruz — NFR-07 flow and latency",
  "tags": ["vidacruz", "nfr-07"],
  "schemaVersion": 39,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "stat",
      "title": "Pacientes clasificados",
      "description": "RF-01 registrations in the selected range, by triage level.",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [{ "refId": "A", "expr": "sum(increase(triage_patients_classified_total[$__range]))" }]
    },
    {
      "type": "stat",
      "title": "Escalados por SLA",
      "description": "RF-03 escalations in the selected range.",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [{ "refId": "A", "expr": "sum(increase(triage_patients_escalated_total[$__range]))" }]
    },
    {
      "type": "stat",
      "title": "Alertas reconocidas",
      "description": "RF-06 acknowledgements in the selected range.",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [{ "refId": "A", "expr": "sum(increase(triage_alerts_acknowledged_total[$__range]))" }]
    },
    {
      "type": "stat",
      "title": "Escalados sin reconocer",
      "description": "Escalations minus acknowledgements in the selected range, floored at zero.",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [{
        "refId": "A",
        "expr": "round(clamp_min(sum(increase(triage_patients_escalated_total[$__range])) - sum(increase(triage_alerts_acknowledged_total[$__range])), 0))"
      }]
    },
    {
      "type": "timeseries",
      "title": "Clasificación y escalado por nivel",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        { "refId": "A", "expr": "sum by (level) (rate(triage_patients_classified_total[1m]))", "legendFormat": "clasificados {{level}}" },
        { "refId": "B", "expr": "sum by (level) (rate(triage_patients_escalated_total[1m]))", "legendFormat": "escalados {{level}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Alertas reconocidas por nivel",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        { "refId": "A", "expr": "sum by (level) (rate(triage_alerts_acknowledged_total[1m]))", "legendFormat": "{{level}}" }
      ]
    },
    {
      "type": "stat",
      "title": "Preguntas respondidas",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [{ "refId": "A", "expr": "sum(increase(assistant_answers_total{outcome=\"answered\"}[$__range]))" }]
    },
    {
      "type": "stat",
      "title": "Sin protocolo",
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [{ "refId": "A", "expr": "sum(increase(assistant_answers_total{outcome=\"no_evidence\"}[$__range]))" }]
    },
    {
      "type": "stat",
      "title": "Modo degradado (503)",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [{ "refId": "A", "expr": "sum(increase(assistant_answers_total{outcome=\"unavailable\"}[$__range]))" }]
    },
    {
      "type": "timeseries",
      "title": "Desenlace de consultas",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        { "refId": "A", "expr": "sum by (outcome) (rate(assistant_answers_total[1m]))", "legendFormat": "{{outcome}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "LLM provider latency (p50/p95 by outcome)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, outcome) (rate(assistant_llm_latency_seconds_bucket[5m])))",
          "legendFormat": "p95 {{outcome}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.50, sum by (le, outcome) (rate(assistant_llm_latency_seconds_bucket[5m])))",
          "legendFormat": "p50 {{outcome}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Eventos de urgencia procesados",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        { "refId": "A", "expr": "sum by (result) (rate(assistant_urgency_events_total[1m]))", "legendFormat": "{{result}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latencia HTTP p95 por servicio",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [{
        "refId": "A",
        "expr": "histogram_quantile(0.95, sum by (le, application) (rate(http_server_requests_seconds_bucket[5m])))",
        "legendFormat": "{{application}}"
      }]
    },
    {
      "type": "timeseries",
      "title": "Respuestas HTTP 4xx/5xx por servicio",
      "description": "Error responses during the previous minute, including the first one of a new status or route. A series that appears while its target was not being scraped a minute earlier is left out, so a failed scrape does not show lifetime totals.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [{
        "refId": "A",
        "expr": "sum by (application, status) (clamp_min(http_server_requests_seconds_count{status=~\"4..|5..\"} - http_server_requests_seconds_count{status=~\"4..|5..\"} offset 1m, 0) or ((http_server_requests_seconds_count{status=~\"4..|5..\"} unless http_server_requests_seconds_count{status=~\"4..|5..\"} offset 1m) and on (job, instance) (up offset 1m == 1)))",
        "legendFormat": "{{application}} {{status}}"
      }]
    },
    {
      "type": "bargauge",
      "title": "LLM attempts by outcome (selected range)",
      "description": "Provider attempts recorded by the failover router, including failures before failover.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "displayMode": "gradient", "orientation": "horizontal", "showUnfilled": true },
      "targets": [{
        "refId": "A",
        "expr": "sum by (outcome) (increase(assistant_llm_latency_seconds_count[$__range]))",
        "legendFormat": "{{outcome}}"
      }]
    },
    {
      "type": "timeseries",
      "title": "Kafka consumer lag by partition",
      "description": "Lag of the urgency consumer on the canonical patient-events topic.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [{
        "refId": "A",
        "expr": "max by (partition) (kafka_consumer_fetch_manager_records_lag{topic=\"triaje_eventos\"})",
        "legendFormat": "partition {{partition}}"
      }]
    },
    {
      "type": "timeseries",
      "title": "JVM heap memory by service",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 48 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [{
        "refId": "A",
        "expr": "sum by (application) (jvm_memory_used_bytes{area=\"heap\"})",
        "legendFormat": "{{application}}"
      }]
    },
    {
      "type": "timeseries",
      "title": "Process CPU by service",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 48 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [{
        "refId": "A",
        "expr": "max by (application) (process_cpu_usage)",
        "legendFormat": "{{application}}"
      }]
    },
    {
      "type": "timeseries",
      "title": "PostgreSQL pool connections by service",
      "description": "R2DBC pools plus the JDBC (Hikari) pool the assistant uses for pgvector.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 56 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        { "refId": "A", "expr": "sum by (application) (r2dbc_pool_acquired_connections)", "legendFormat": "{{application}} r2dbc acquired" },
        { "refId": "B", "expr": "sum by (application) (r2dbc_pool_idle_connections)", "legendFormat": "{{application}} r2dbc idle" },
        { "refId": "C", "expr": "sum by (application) (r2dbc_pool_pending_connections)", "legendFormat": "{{application}} r2dbc pending" },
        { "refId": "D", "expr": "sum by (application) (hikaricp_connections_active)", "legendFormat": "{{application}} jdbc active" },
        { "refId": "E", "expr": "sum by (application) (hikaricp_connections_idle)", "legendFormat": "{{application}} jdbc idle" },
        { "refId": "F", "expr": "sum by (application) (hikaricp_connections_pending)", "legendFormat": "{{application}} jdbc pending" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Redis command latency",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 56 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [{
        "refId": "A",
        "expr": "sum(rate(lettuce_command_completion_seconds_sum[1m])) / (sum(rate(lettuce_command_completion_seconds_count[1m])) > 0)",
        "legendFormat": "average command"
      }]
    },
    {
      "type": "timeseries",
      "title": "HTTP p95 by route",
      "description": "Actuator and docs routes are excluded so the application paths stay readable.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 64 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [{
        "refId": "A",
        "expr": "histogram_quantile(0.95, sum by (le, application, method, uri) (rate(http_server_requests_seconds_bucket{uri!~\"/actuator/.*|/health.*|/prometheus|/v3/api-docs.*|/swagger-ui.*|/webjars.*\"}[5m])))",
        "legendFormat": "{{application}} {{method}} {{uri}}"
      }]
    },
    {
      "type": "timeseries",
      "title": "Escalations and acknowledgements (per minute)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 72 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        { "refId": "A", "expr": "sum(increase(triage_patients_escalated_total[1m]))", "legendFormat": "escalated" },
        { "refId": "B", "expr": "sum(increase(triage_alerts_acknowledged_total[1m]))", "legendFormat": "acknowledged" }
      ]
    }
  ]
}
