# Java and compiled output
*.class

# Archives
*.jar
!**/gradle/wrapper/gradle-wrapper.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Secrets and local configuration (API keys, credentials)
.env
.env.*
!.env.example
*.local.yaml
*.local.yml
application-local.*

# Binary and lock files
*.bin
*.lock

# Tool state files (not the Gradle wrapper: gradle-wrapper.properties must stay tracked)
cache.properties
gc.properties

# Logs and JVM crash dumps
*.log
hs_err_pid*
replay_pid*

# BlueJ
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Build output and IDE state at repository root (services also ignore these in their own .gitignore)
.gradle/
build/
.idea/
*.iml
.vscode/
