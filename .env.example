# Copy to .env for local overrides. Never commit the real file (.env is gitignored).
# These defaults are local-only test values; rotate them for any shared environment.

TRIAGE_API_KEY=test-triage-key
ASSISTANT_API_KEY=test-assistant-key
TRIAGE_DB_PASSWORD=triage_local
ASSISTANT_DB_PASSWORD=assistant_local

# Host ports
TRIAGE_PORT=8081
ASSISTANT_PORT=8082
TRIAGE_DB_PORT=5432
ASSISTANT_DB_PORT=5433
KAFKA_PORT=9092
REDIS_PORT=6379

# RF-03 demo SLA in minutes (spec defaults are 5/10/30/60/120)
SLA_CRITICO_MINUTES=1
SLA_URGENTE_MINUTES=1
SLA_URGENTE_2_MINUTES=2
SLA_NO_URGENTE_MINUTES=5
SLA_NO_URGENTE_2_MINUTES=5

# RF-04 provider. Leave empty to exercise the 503 degraded-mode notice.
# Use http://host.docker.internal:11434 for an Ollama running on the host.
RAG_LLM_CHAIN=ollama
OLLAMA_BASE_URL=http://ollama:11434
GEMINI_API_KEY=
OPENCODE_API_KEY=
